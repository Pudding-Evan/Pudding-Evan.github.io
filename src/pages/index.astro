---
import SiteLayout from "../layouts/SiteLayout.astro";
import { displayDate, getFeaturedVideos, getHomeArticles } from "../lib/content";

const posts = getHomeArticles();
const videos = getFeaturedVideos();
const articleCount = posts.length;
const books = ["book_1_trim.png", "book_2_trim.png", "book_3_trim.png"];
const bookClasses = ["book-spine-red", "book-spine-blue", "book-spine-green"];
---

<SiteLayout
  title="Elysium"
  description="Evan 的 Unreal Engine、Gameplay 与游戏开发笔记。"
  htmlClass="home-document"
  bodyClass="home-page"
  interfaceStyle="ornate"
>
  <main class="home-scroll">
    <section class="signature-hero home-panel" aria-labelledby="site-intro-title" data-home-section>
      <div class="hero-grid site-shell">
        <div class="hero-copy scroll-reveal">
          <p class="system-kicker"><span>~/elysium</span> <span>branch: main</span></p>
          <h1 id="site-intro-title">蝴蝶跃海</h1>
          <p class="hero-lead">—— 行久之物，族必起于少</p>
          <div class="hero-actions">
            <a class="primary-action" href="#home-notes">阅读最新笔记</a>
          </div>
          <dl class="hero-status" aria-label="站点概况">
            <div><dt>NOTES</dt><dd>{articleCount.toString().padStart(2, "0")}</dd></div>
            <div><dt>FOCUS</dt><dd>UE / GAMEPLAY</dd></div>
            <div><dt>STATUS</dt><dd>CONTINUOUS</dd></div>
          </dl>
        </div>
        <figure class="hero-visual scroll-reveal">
          <img class="signature-banner" src="assets/background.jpg" alt="Elysium 主题插画" width="1908" height="573" fetchpriority="high">
          <figcaption>
            <span>FIELD_NOTE / 001</span>
            <q>Courage need not be remembered, for it is never forgotten.</q>
          </figcaption>
        </figure>
      </div>
    </section>

    <section class="section section-alt home-panel home-panel-note" id="home-notes" data-home-section>
      <div class="site-shell">
        <div class="section-heading scroll-reveal">
          <div><p class="eyebrow">01 / RECENT LOG</p><h2 class="pixel-title">最新笔记</h2></div>
          <a class="text-link" href="articles.html">VIEW ALL</a>
        </div>
        <div class="book-stack scroll-reveal">
          {
            posts.slice(0, 5).map((post, index) => (
              <a class={`book-spine ${bookClasses[index % bookClasses.length]}`} href={`posts/${post.slug}.html`}>
                <img src={`assets/${books[index % books.length]}`} alt="" loading="lazy">
                <time class="book-date" datetime={post.date}>{displayDate(post.date)}</time>
                <h3>{post.title}</h3>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section home-panel home-panel-video" id="home-videos" data-home-section>
      <div class="site-shell">
        <div class="section-heading scroll-reveal">
          <div><p class="eyebrow">02 / BUILD CAPTURE</p><h2 class="pixel-title">视频记录</h2></div>
          <a class="text-link" href="videos.html">VIEW VIDEOS</a>
        </div>
        <div class="switch-player-list scroll-reveal">
          {
            videos.map((video) => (
              <article class="switch-player" id={video.elementId}>
                <div class="switch-player-body">
                  <div class="switch-player-copy"><h3>{video.title}</h3></div>
                  <div class="switch-screen">
                    <iframe
                      src={video.embedUrl}
                      title={video.title}
                      allow="autoplay; fullscreen; picture-in-picture"
                      referrerpolicy="strict-origin-when-cross-origin"
                      loading="lazy"
                      allowfullscreen
                    />
                  </div>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>
  </main>
</SiteLayout>
