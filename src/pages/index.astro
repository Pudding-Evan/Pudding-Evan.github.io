---
import SiteLayout from "../layouts/SiteLayout.astro";
import { displayDate, getFeaturedVideos, getHomeArticles } from "../lib/content";

const posts = getHomeArticles();
const videos = getFeaturedVideos();
const books = ["book_1_trim.png", "book_2_trim.png", "book_3_trim.png"];
const bookClasses = ["book-spine-red", "book-spine-blue", "book-spine-green"];
---

<SiteLayout
  title="Elysium"
  description="Elysium: notes, development logs, and videos."
  htmlClass="home-document"
  bodyClass="home-page"
>
  <main class="home-scroll">
    <section class="signature-hero home-panel" aria-label="Elysium signature" data-home-section>
      <div class="signature-shell site-shell">
        <figure class="signature-parchment">
          <img src="assets/decor/paper-signature.png" alt="Decorative parchment paper">
          <figcaption class="signature-ink">
            <p>Courage need not be remembered,<br>for it is never forgotten.</p>
            <cite class="signature-credit">- Zelda</cite>
          </figcaption>
        </figure>
        <a class="scroll-sigil" href="#home-notes" aria-label="前往笔记区"><span aria-hidden="true"></span></a>
      </div>
    </section>

    <section class="section section-alt home-panel home-panel-note" id="home-notes" data-home-section>
      <div class="site-shell">
        <div class="section-heading scroll-reveal">
          <div><p class="eyebrow">01 / Archive</p><h2 class="pixel-title">NOTE</h2></div>
          <a class="text-link" href="articles.html">VIEW ALL</a>
        </div>
        <div class="book-stack scroll-reveal">
          {
            posts.slice(0, 5).map((post, index) => (
              <a class={`book-spine ${bookClasses[index % bookClasses.length]}`} href={`posts/${post.slug}.html`}>
                <img src={`assets/${books[index % books.length]}`} alt="">
                <time class="book-date" datetime={post.date}>{displayDate(post.date)}</time>
                <h3>{post.title}</h3>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section home-panel home-panel-video" id="home-videos" data-home-section>
      <div class="site-shell">
        <div class="section-heading scroll-reveal">
          <div><p class="eyebrow">02 / Video</p><h2 class="pixel-title">Video</h2></div>
          <a class="text-link" href="videos.html">VIEW VIDEOS</a>
        </div>
        <div class="switch-player-list scroll-reveal">
          {
            videos.map((video) => (
              <article class="switch-player" id={video.elementId}>
                <div class="switch-player-body">
                  <div class="switch-player-copy"><h3>{video.title}</h3></div>
                  <div class="switch-screen">
                    <iframe
                      src={video.embedUrl}
                      title={video.title}
                      allow="autoplay; fullscreen; picture-in-picture"
                      referrerpolicy="strict-origin-when-cross-origin"
                      allowfullscreen
                    />
                  </div>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>
  </main>
</SiteLayout>
