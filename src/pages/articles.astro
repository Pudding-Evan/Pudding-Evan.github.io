---
import SiteLayout from "../layouts/SiteLayout.astro";
import { displayDate, getAllArticles, tagFilterValue } from "../lib/content";

const posts = getAllArticles();
const tagOrder = ["Note", "Gameplay", "GAS", "Net", "Asset", "UE5", "U++"];
const tagMap = new Map<string, string>();
for (const post of posts) {
  for (const tag of post.tags) {
    tagMap.set(tag.toLowerCase(), tag);
  }
}
const tags = [
  ...tagOrder.filter((tag) => tagMap.has(tag.toLowerCase())),
  ...[...tagMap.values()].filter(
    (tag) => !tagOrder.some((orderedTag) => orderedTag.toLowerCase() === tag.toLowerCase())
  )
];
const groupedPosts = [...new Map(posts.map((post) => [post.month, post.monthLabel])).entries()].map(([month, label]) => ({
  month,
  label,
  posts: posts.filter((post) => post.month === month)
}));
---

<SiteLayout title="NOTE" description="Elysium notes and development articles." current="note" bodyClass="plain-content-page">
  <main class="site-shell">
    <section class="page-intro">
      <p class="eyebrow">01 / Timeline</p>
      <h1 class="pixel-title">NOTE</h1>
    </section>
    <section class="article-browser" data-article-browser aria-label="文章列表">
      <div class="article-layout">
        <div class="note-archive-card">
          {
            groupedPosts.map((group) => (
              <section class="note-group" data-article-group={group.month} aria-labelledby={`note-group-${group.month}`}>
                <div class="note-group-heading">
                  <h2 id={`note-group-${group.month}`}>{group.label}</h2>
                  <span>{group.posts.length.toString().padStart(2, "0")}</span>
                </div>
                <div class="note-link-list">
                  {
                    group.posts.map((post) => (
                      <a class="note-link-row" data-tags={post.tags.map(tagFilterValue).join(" ")} href={`posts/${post.slug}.html`}>
                        <time class="note-link-date" datetime={post.date}>[{displayDate(post.date)}]</time>
                        <span class="note-link-main">
                          <span class="note-link-title">{post.title}</span>
                          <span class="note-link-tags" aria-label="文章标签">
                            {post.tags.map((tag) => <span>{tag}</span>)}
                          </span>
                        </span>
                      </a>
                    ))
                  }
                </div>
              </section>
            ))
          }
        </div>
        <aside class="tag-panel" aria-label="按 Tag 筛选文章">
          <nav class="tag-filter">
            <a href="articles.html" data-tag-filter="all" aria-pressed="true">All</a>
            {tags.map((tag) => <a href={`articles.html?tag=${encodeURIComponent(tagFilterValue(tag))}`} data-tag-filter={tagFilterValue(tag)} aria-pressed="false">{tag}</a>)}
          </nav>
        </aside>
      </div>
      <p class="archive-empty" data-archive-empty hidden>这个 Tag 下面还没有文章。</p>
    </section>
  </main>
</SiteLayout>