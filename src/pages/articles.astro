---
import SiteLayout from "../layouts/SiteLayout.astro";
import { displayDate, getAllArticles, tagFilterValue } from "../lib/content";

const posts = getAllArticles();
const tagOrder = ["Note", "Gameplay"];
const tags = [
  ...tagOrder.filter((tag) => posts.some((post) => post.tag.toLowerCase() === tag.toLowerCase())),
  ...[...new Map(posts.map((post) => [post.tag.toLowerCase(), post.tag])).values()].filter(
    (tag) => !tagOrder.some((orderedTag) => orderedTag.toLowerCase() === tag.toLowerCase())
  )
];
const groupedPosts = tags.map((tag) => ({
  tag,
  posts: posts.filter((post) => post.tag.toLowerCase() === tag.toLowerCase())
}));
---

<SiteLayout title="NOTE" description="Elysium notes and development articles." current="note">
  <main class="site-shell">
    <section class="page-intro">
      <p class="eyebrow">01 / Archive</p>
      <h1 class="pixel-title">NOTE</h1>
      <p>阁楼上的小抽屉</p>
    </section>
    <section class="article-browser" data-article-browser aria-label="文章列表">
      <div class="article-layout">
        <div class="note-archive-card">
          {
            groupedPosts.map((group) => (
              <section class="note-group" data-article-group={tagFilterValue(group.tag)} aria-labelledby={`note-group-${tagFilterValue(group.tag)}`}>
                <div class="note-group-heading">
                  <h2 id={`note-group-${tagFilterValue(group.tag)}`}>{group.tag}</h2>
                  <span>{group.posts.length.toString().padStart(2, "0")}</span>
                </div>
                <div class="note-link-list">
                  {
                    group.posts.map((post) => (
                      <a class="note-link-row" data-tag={tagFilterValue(post.tag)} href={`posts/${post.slug}.html`}>
                        <time class="note-link-date" datetime={post.date}>[{displayDate(post.date)}]</time>
                        <span class="note-link-title">{post.title}</span>
                        <span class="note-link-summary">{post.summary}</span>
                      </a>
                    ))
                  }
                </div>
              </section>
            ))
          }
        </div>
        <aside class="tag-panel" aria-label="按 Tag 筛选文章">
          <p class="tag-panel-title">Tag</p>
          <nav class="tag-filter">
            <a href="articles.html" data-tag-filter="all" aria-pressed="true">All</a>
            {tags.map((tag) => <a href={`articles.html?tag=${tagFilterValue(tag)}`} data-tag-filter={tagFilterValue(tag)} aria-pressed="false">{tag}</a>)}
          </nav>
        </aside>
      </div>
      <p class="archive-empty" data-archive-empty hidden>这个 Tag 下面还没有文章。</p>
    </section>
  </main>
</SiteLayout>
