---
import SiteLayout from "../layouts/SiteLayout.astro";
import { ARTICLE_COLLECTIONS, displayDate, getAllArticles, getPublicArticles, tagFilterValue } from "../lib/content";

const posts = getAllArticles();
const publicPosts = getPublicArticles();
const tags = ["Note", "GAS", "Net"].filter((tag) => publicPosts.some((post) => post.tags.includes(tag)));
const groupedPosts = [...new Map(posts.map((post) => [post.month, post.monthLabel])).entries()].map(([month, label]) => ({
  month,
  label,
  posts: posts.filter((post) => post.month === month)
}));
---

<SiteLayout title="开发笔记" description="Evan 的 Unreal Engine、Gameplay、GAS 与游戏开发文章。" current="note" bodyClass="plain-content-page" interfaceStyle="minimal">
  <main class="site-shell">
    <section class="page-intro">
      <p class="eyebrow">01 / KNOWLEDGE LOG</p>
      <h1 class="pixel-title">开发笔记</h1>
    </section>
    <section class="article-browser" data-article-browser aria-label="文章列表">
      <div class="article-layout">
        <div class="note-archive-card">
          {
            groupedPosts.map((group) => (
              <section class="note-group" data-article-group={group.month} aria-labelledby={`note-group-${group.month}`} hidden={group.posts.every((post) => Boolean(post.collection))}>
                <div class="note-group-heading">
                  <h2 id={`note-group-${group.month}`}>{group.label}</h2>
                  <span data-group-count>{group.posts.filter((post) => !post.collection).length.toString().padStart(2, "0")}</span>
                </div>
                <div class="note-link-list">
                  {
                    group.posts.map((post) => (
                      <a
                        class="note-link-row"
                        data-tags={post.tags.map(tagFilterValue).join(" ")}
                        data-collection={post.collection ? tagFilterValue(post.collection) : undefined}
                        href={`posts/${post.slug}.html`}
                        hidden={Boolean(post.collection)}
                      >
                        <time class="note-link-date" datetime={post.date}>[{displayDate(post.date)}]</time>
                        <span class="note-link-main">
                          <span class="note-link-title">{post.title}</span>
                          <span class="note-link-tags" aria-label="文章标签">
                            {(post.collection ? [post.collection] : post.tags).map((tag) => <span>{tag}</span>)}
                          </span>
                        </span>
                      </a>
                    ))
                  }
                </div>
              </section>
            ))
          }
        </div>
        <aside class="tag-panel" aria-label="筛选文章分类">
          <p class="tag-panel-title">FILTER / ARCHIVE</p>
          <nav class="tag-filter">
            <a href="articles.html" data-tag-filter="all" aria-pressed="true">All</a>
            {tags.map((tag) => <a href={`articles.html?tag=${encodeURIComponent(tagFilterValue(tag))}`} data-tag-filter={tagFilterValue(tag)} aria-pressed="false">{tag}</a>)}
            {ARTICLE_COLLECTIONS.map((collection) => <a href={`articles.html?category=${encodeURIComponent(tagFilterValue(collection))}`} data-category-filter={tagFilterValue(collection)} aria-pressed="false">{collection}</a>)}
          </nav>
        </aside>
      </div>
      <p class="archive-empty" data-archive-empty hidden>这个分类下还没有文章。</p>
    </section>
  </main>
</SiteLayout>