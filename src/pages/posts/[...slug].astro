---
import SiteLayout from "../../layouts/SiteLayout.astro";
import { displayDate, getAllArticles, tagFilterValue } from "../../lib/content";

export function getStaticPaths() {
  return getAllArticles().map((post) => ({
    params: { slug: post.slug },
    props: { post }
  }));
}

const { post } = Astro.props;
const Content = post.Content;
const tocHeadings = post.headings;
const rootPrefix = "../".repeat(post.slug.split("/").length);
---

<SiteLayout title={post.title} description={post.summary} current="note" prefix={rootPrefix} bodyClass="plain-content-page">
  <main class="article-page site-shell">
    <a class="text-link article-back" href={`${rootPrefix}articles.html`}>BACK TO ARTICLES</a>
    <div class="article-shell">
      <article class="article">
        <div class="meta">
          {post.tags.map((tag) => <a class="meta-tag" href={`${rootPrefix}articles.html?tag=${encodeURIComponent(tagFilterValue(tag))}`}>{tag}</a>)}
          <span>{displayDate(post.date)}</span>
          <span>{post.readMinutes} MIN READ</span>
        </div>
        <Content />
      </article>
      {tocHeadings.length > 0 && (
        <aside class="article-toc" aria-label="文章目录">
          <h2 class="article-toc-title">CONTENTS</h2>
          <nav>
            {tocHeadings.map((heading) => (
              <a class={`article-toc-link depth-${heading.depth}`} href={`#${heading.slug}`}>
                {heading.text}
              </a>
            ))}
          </nav>
        </aside>
      )}
    </div>
  </main>
</SiteLayout>
