---
interface Props {
  title?: string;
  description?: string;
  current?: "note" | "video" | "";
  prefix?: string;
  htmlClass?: string;
  bodyClass?: string;
  type?: "website" | "article";
  publishedTime?: string;
  tags?: string[];
  interfaceStyle?: "ornate" | "minimal";
}

const {
  title = "Elysium",
  description = "Evan 的 Unreal Engine、Gameplay 与游戏开发笔记。",
  current = "",
  prefix = "",
  htmlClass = "",
  bodyClass = "",
  type = "website",
  publishedTime,
  tags = [],
  interfaceStyle = "ornate"
} = Astro.props;

const pageTitle = title === "Elysium" ? "Elysium" : `${title} | Elysium`;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL("assets/background.jpg", Astro.site);
const currentYear = new Date().getFullYear();
---

<!doctype html>
<html class={htmlClass || undefined} lang="zh-CN" data-style={interfaceStyle}>
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content={description}>
    <meta name="author" content="Evan">
    <meta name="theme-color" content="#f7f6ef">
    <link rel="canonical" href={canonicalUrl}>
    <link rel="icon" href={`${prefix}favicon.svg`} type="image/svg+xml">
    <link rel="alternate" type="application/rss+xml" title="Elysium RSS" href={`${prefix}rss.xml`}>
    <meta property="og:site_name" content="Elysium">
    <meta property="og:type" content={type}>
    <meta property="og:title" content={pageTitle}>
    <meta property="og:description" content={description}>
    <meta property="og:url" content={canonicalUrl}>
    <meta property="og:image" content={socialImage}>
    <meta name="twitter:card" content="summary_large_image">
    {publishedTime && <meta property="article:published_time" content={publishedTime}>}
    {tags.map((tag) => <meta property="article:tag" content={tag}>)}
    <title>{pageTitle}</title>
    <link rel="stylesheet" href={`${prefix}styles.css`}>
    <link rel="stylesheet" href={`${prefix}interface.css`}>
    <script src={`${prefix}site.js`} defer></script>
  </head>
  <body class={bodyClass || undefined}>
    <header class="site-header">
      <nav class="nav site-shell" aria-label="主导航">
        <a
          class="brand-reveal"
          href={`${prefix}index.html`}
          aria-label="Elysium 首页"
        >
          <span class="brand-initial" aria-hidden="true">E</span>
          <span class="brand-rest" aria-hidden="true">LYSIUM</span>
        </a>
        <div class="nav-controls">
          <div class="nav-links">
            <a href={`${prefix}articles.html`} aria-current={current === "note" ? "page" : undefined}>NOTE</a>
            <a href={`${prefix}videos.html`} aria-current={current === "video" ? "page" : undefined}>VIDEO</a>
          </div>
        </div>
      </nav>
    </header>

    <slot />

    <footer class="site-footer">
      <div class="footer-inner site-shell">
        <div class="footer-identity">
          <strong>Elysium</strong>
        </div>
        <nav class="footer-links" aria-label="页脚导航">
          <a href="https://github.com/Pudding-Evan" rel="noopener">GITHUB</a>
        </nav>
        <span class="footer-copyright">© {currentYear} Evan</span>
      </div>
    </footer>
  </body>
</html>
